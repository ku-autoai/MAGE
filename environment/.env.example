# Copy to .env. Use the host address reachable from the containers.
GUI_AGENT_SERVER_HOST=host.docker.internal
# Replace before starting a desktop. This is not an actual credential.
VNC_PW=replace-with-your-own-password
# Match these ports to the corresponding running agent servers.
CALC_SERVER_PORT=7777
IMPRESS_SERVER_PORT=8888
WRITER_SERVER_PORT=9999
SLACK_SERVER_PORT=1111
GIMP_SERVER_PORT=5555
VSCODE_SERVER_PORT=4444
SLACK_WEB_URL=https://your-workspace.slack.com
# EX resets the VS Code benchmark state. Set false to preserve each scope.
VSCODE_RESET_CONFIG_ON_EX=true
VSCODE_RESET_EXTENSIONS_ON_EX=true
VSCODE_RESET_WORKSPACE_ON_EX=true
