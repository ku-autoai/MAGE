# =========================
# Common API credentials
# =========================
OPENAI_API_KEY=your_openai_api_key_here

# =========================
# Common path templates for train configs
# =========================
# Used by components/Model_trainer/config/train/*.json
DATA_ROOT=/path/to/data_root
OUTPUT_ROOT=/path/to/output_root

# =========================
# Episode generator task json overrides (optional)
# =========================
# Relative paths are resolved against components/Episode_generator/.
# EPG_TASK_CALC_VAL=Task/calc_val.json
# EPG_TASK_CALC_TRAIN=Task/calc_train.json
# EPG_TASK_IMPRESS_VAL=Task/impress_val.json
# EPG_TASK_IMPRESS_TRAIN=Task/impress_train.json
# EPG_TASK_WRITER_VAL=Task/writer_val.json
# EPG_TASK_WRITER_TRAIN=Task/writer_train.json
# EPG_TASK_SLACK_TRAIN=Task/slack_train.json
# EPG_TASK_SLACK_VAL=Task/slack_val.json

# =========================
# components/rap (optional overrides)
# =========================
# RBP_MANUAL_PATH=/absolute/or/relative/path/to/manual.json
# RBP_PROGRAM_NAME=libreoffice_calc
# RBP_EVALUATION_EXAMPLES_ROOT=/path/to/evaluation_examples
# RBP_OUTPUT_ROOT=/path/to/output_root
# RBP_FIRST_IMAGE_ROOT=/path/to/first_screen_images
# RBP_EMBED_MODEL_ID=Qwen/Qwen3-Embedding-0.6B
# RBP_REWRITE_MODEL_ID=Qwen/Qwen3.6-27B
# RBP_EMBED_DEVICE_NUM=1
# RBP_GENERATION_DEVICE_NUMS=0,1,2,3
# RBP_TOPK=5
# RBP_GENERATION_BATCH_SIZE=3
# RBP_MAX_NEW_TOKENS=512
